<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="8dp">

    <TextView
        android:id="@+id/menuSettings"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/settings"
        android:textSize="18sp"
        android:padding="12dp"
        android:drawablePadding="16dp"
        android:drawableStart="@android:drawable/ic_menu_preferences"
        android:gravity="center_vertical"
        android:background="?attr/selectableItemBackground" />

    <TextView
        android:id="@+id/menuSave"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/save_position"
        android:textSize="18sp"
        android:padding="12dp"
        android:drawablePadding="16dp"
        android:drawableStart="@drawable/ic_bookmark_add"
        android:gravity="center_vertical"
        android:background="?attr/selectableItemBackground" />

    <TextView
        android:id="@+id/menuLoad"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/load_position"
        android:textSize="18sp"
        android:padding="12dp"
        android:drawablePadding="16dp"
        android:drawableStart="@drawable/ic_bookmark_added"
        android:gravity="center_vertical"
        android:background="?attr/selectableItemBackground" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#DDDDDD"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp"/>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Capitoli"
        android:textStyle="bold"
        android:paddingStart="12dp"
        android:paddingBottom="8dp"
        android:textColor="#888888"/>

</LinearLayout>